{
  "name": "mcp-vision-bridge",
  "version": "0.2.3",
  "description": "Give text-only LLM coding agents (DeepSeek V4 Flash/Pro, Qwen, Kimi) vision via any multimodal model. One MCP tool, works with Claude Code, opencode, Codex, Kimi Code, PI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-vision-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    "examples",
    "README-CN.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/e2e-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "multimodal",
    "llm",
    "agent",
    "ocr",
    "claude-code",
    "opencode",
    "codex"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
