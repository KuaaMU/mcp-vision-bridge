{
  "mcpServers": {
    "vision": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-vision-bridge"],
      "env": {
        "VISION_OPENAI_BASE_URL": "${user_config.vision_openai_base_url}",
        "VISION_OPENAI_API_KEY": "${user_config.vision_openai_api_key}",
        "VISION_MODEL": "${user_config.vision_model}"
      }
    }
  }
}
